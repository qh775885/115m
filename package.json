{
  "name": "115m",
  "version": "1.7.3",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "build": "node scripts/sync-manifest-version.mjs && vite build",
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "pnpm build && powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (!(Test-Path release)) { New-Item -ItemType Directory -Path release | Out-Null }; $v=(Get-Content package.json -Raw | ConvertFrom-Json).version; $out='release/115m-v' + $v + '.zip'; if (Test-Path $out) { Remove-Item -Force $out }; Compress-Archive -Path 'dist/*' -DestinationPath $out -Force\""
  },
  "dependencies": {
    "@cbingbing/demuxer": "^2.4.1",
    "artplayer": "^5.4.0",
    "blueimp-md5": "^2.19.0",
    "hls.js": "^1.6.16",
    "m3u8-parser": "^7.2.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/blueimp-md5": "^2.18.2",
    "@types/chrome": "^0.2.2",
    "@types/m3u8-parser": "^7.2.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
